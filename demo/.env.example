# Base URL of the monitored RAG service (the FastAPI app in ../app).
# Local docker-compose exposes it on :8000. For a hosted demo, point this at
# whatever tunnel or host fronts that service.
#
# This app never calls an LLM provider directly and holds no model API key —
# generation happens inside the instrumented FastAPI service so that every
# request stays on the measured, traced code path.
RAG_API_URL=http://localhost:8000

# Must match ADMIN_TOKEN in the repo-root .env. The console's scenario controls
# post to /admin/flags, which app/flags.py rejects without it — unless that var
# is also unset there, which leaves the endpoint open in local-demo mode.
# Server-side only; never sent to the browser.
ADMIN_TOKEN=

# Optional header links. Each link is hidden when its var is unset, so an
# unconfigured deploy degrades to a bare page rather than dead links.
# NEXT_PUBLIC_REPORTS_URL=http://localhost:8000/report
# NEXT_PUBLIC_SIGNOZ_DASHBOARD_URL=
