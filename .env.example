OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agent-k-rag-service
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

DATABASE_URL=postgresql+asyncpg://agentk:agentk@localhost:5432/agentk
LLM_PROVIDER=groq
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Admin failure-injection endpoint token (Phase 3, FLAG-01). Empty = open (local demo).
ADMIN_TOKEN=

# Which seeded failure scenario the containerized app starts with (FLAG-01).
# Empty = healthy. The v2-broken image is this same image run with
# AGENT_K_SEEDED_FLAGS=prompt_regression — see Dockerfile.
AGENT_K_SEEDED_FLAGS=

# Law 2 rollback (Phase 6, LAW2-03/04). DEPLOYER_TOKEN is REQUIRED by
# docker-compose.yaml (${DEPLOYER_TOKEN:?...}) — `docker compose up` refuses to
# start any service without it, including rag-postgres. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# The app and the sidecar must share the same value; both read this one var.
DEPLOYER_TOKEN=
DEPLOYER_URL=http://localhost:9000

# Which image tag rag-app runs, and the known-good tag a rollback returns to.
# Build the images before `docker compose up -d rag-app` — compose declares no
# `build:` for rag-app, so it would otherwise try to pull a nonexistent image:
#   docker build -t agent-k-rag:v1-good .
RAG_IMAGE_TAG=v1-good
ROLLBACK_KNOWN_GOOD_TAG=v1-good
# Comma-separated list of origins allowed to call this API from browser JS
# (e.g. your Vercel domain). Empty = CORS disabled, no cross-origin JS calls allowed.
ALLOWED_ORIGINS=

# SigNoz MCP server (Phase 4, MCP-01/02). SIGNOZ_MCP_COMMAND is the path to the
# signoz-mcp-server binary/executable; SIGNOZ_URL/SIGNOZ_API_KEY are passed through
# to that subprocess's environment, not read directly by Agent K's own process.
#
# SIGNOZ_URL is also the base for every evidence deep link built in
# app/claims.py, so it must be the SigNoz *UI* host — not the OTLP ingest host.
# The prebuilt signoz-mcp-server.exe is committed to bin/ for Windows users.
# On Linux/macOS, build from source — see docs/MCP-SETUP.md.
SIGNOZ_MCP_COMMAND=bin/signoz-mcp-server.exe
SIGNOZ_URL=http://localhost:8080
SIGNOZ_API_KEY=
