.planning/research/.cache/

# Node.js dependencies
**/node_modules/

# Next.js build output
**/.next/
**/out/

# Build, coverage, and cache artifacts
**/dist/
**/build/
**/coverage/
**/.turbo/
**/*.tsbuildinfo

# Local environment files
**/.env*
!**/.env.example
!**/.env.template

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo
.claude

# Secrets
.env

# Foundry-generated output (regenerable via `foundryctl forge`)
pours/

# Machine-specific Compose overrides (e.g. remapping a host port that another
# project already holds). Compose auto-loads this when present; teammates
# without it get the defaults in docker-compose.yaml.
docker-compose.override.yaml
docker-compose.override.yml

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# SigNoz MCP server binary (downloaded per-machine, see RUNNING-AGENT-K.md)
signoz-mcp-server
