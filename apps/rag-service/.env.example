# ─── LLM Provider (single OpenAI-compatible client, env-var swappable) ───
# Provider: groq | cerebras | gemini
LLM_PROVIDER=groq

# Groq (primary) — https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Cerebras (eval-day overflow) — https://inference.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.1-8b-instant

# Gemini Flash (tool-calling fallback) — https://ai.google.dev
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://agentk:agentk@localhost:5432/agentk

# ─── Embeddings (local, no external API) ───
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── OpenTelemetry ───
# Exporter: console (default, prints spans to stdout) | otlp (sends to SigNoz)
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rag-support-service

# ─── SigNoz (used later when OTLP exporter is enabled) ───
SIGNOZ_BASE_URL=http://localhost:3301

# ─── App config ───
APP_VERSION=v1
APP_HOST=0.0.0.0
APP_PORT=8000
